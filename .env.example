# Database & App Secrets (Keep private, never commit)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vyaapardb
SECRET_KEY=generate-a-strong-secret-key-at-least-32-chars
ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Payment Gateway Configuration (e.g. Razorpay, Cashfree, PhonePe)
# In development, leave empty or set PAYMENT_GATEWAY=sandbox for built-in UPI simulation
PAYMENT_GATEWAY=sandbox
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# RBI Account Aggregator (Setu AA v2 FIU) Configuration
# Set BANK_DATA_PROVIDER=setu_aa when connecting to Setu Sandbox (https://fiu-sandbox.setu.co/v2) or Prod
BANK_DATA_PROVIDER=mock
SETU_AA_BASE_URL=https://fiu-sandbox.setu.co/v2
SETU_AA_CLIENT_ID=
SETU_AA_CLIENT_SECRET=
SETU_AA_PRODUCT_INSTANCE_ID=
SETU_AA_REDIRECT_URL=http://localhost:5173/app/dashboard
SETU_AA_WEBHOOK_SECRET=

# OTP Login & Consent Verification
# Options: "smtp_email" (Gmail SMTP App Password - free & real), "twilio_verify", "twilio_sms", "sandbox"
OTP_PROVIDER=smtp_email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_FROM_PHONE=
