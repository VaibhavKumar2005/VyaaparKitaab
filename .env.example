# Database & App Secrets (Keep private, never commit)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vyaapardb
SECRET_KEY=generate-a-strong-secret-key-at-least-32-chars
ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Payment Gateway Configuration (e.g. Razorpay, Cashfree, PhonePe)
# In development, leave empty or set PAYMENT_GATEWAY=sandbox for built-in UPI simulation
PAYMENT_GATEWAY=sandbox
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
